# StreamNova Environment Variables Template
# Copy this file to .env.local and fill in the values.
# Do not commit .env.local (containing real secrets) to version control.

# --- APP CONFIGURATION ---
NEXT_PUBLIC_APP_NAME=StreamNova
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- RAZORPAY PAYMENT GATEWAY (Optional for Mock Checkout) ---
# Client-side Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key_here

# Server-side Razorpay Secret Key
RAZORPAY_KEY_SECRET=rzp_test_your_secret_key_here

# --- AUTHENTICATION & SECURITY ---
# NextAuth or JSON Web Token Secret (used for signing sessions)
NEXTAUTH_SECRET=your_jwt_session_secret_min_32_chars_here
NEXTAUTH_URL=http://localhost:3000

# --- SMTP / EMAIL CONFIGURATION (For OTP/Verification) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@streamnova.com
